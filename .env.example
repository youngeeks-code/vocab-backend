PORT=4000
MONGODB_URI=mongodb://localhost:27017/vocab-tracker

# Optional — leave unset for open access (fine for local single-user use).
# Set this once the server stops being purely local; every request then needs
# to send it back via the X-App-Password header.
APP_PASSWORD=

# Optional — leave unset to use the pastable meta-prompt flow instead of live AI generation
ANTHROPIC_API_KEY=

# Optional — leave unset to leave dictionary search as a 501 placeholder
DICTIONARY_API_KEY=
DICTIONARY_API_URL=
